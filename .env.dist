# Deployment configuration for src/client_settings.js.
#
# Copy this file to .env. Every setting below is commented out and inactive
# by default - as shipped, this file changes nothing, and the client builds
# using the defaults documented in client_settings.js.dist. Uncomment and
# edit only the settings you need to change for your vessel/deployment.
# This file is read at build time (npm run build / npm start) - changing it
# requires a rebuild to take effect.

# Set whether the server is using http/https.
# Default is http (false).
# SEALOG_SERVER_TLS=false

# Set the server hostname.
# Default is to use the same hostname as the client URL.
# SEALOG_SERVER_HOSTNAME=

# Set the server port number.
# Default is 8000.
# SEALOG_SERVER_PORT=8000

# URL Root path to the client.
# This MUST match where the client is being hosted by the webserver.
# Change this if not hosting the client at the webserver's document root
# i.e. /sealog/
# Default is /.
# SEALOG_ROOT_PATH=/

# Where the images are hosted on the webserver.
# Default is /files/images.
# SEALOG_IMAGE_PATH=/files/images

# Optional reCaptcha bot abuse protection site key. Default is disabled.
# SEALOG_RECAPTCHA_SITE_KEY=

# Text shown on the login page to the right of the login form.
# Default is the standard Sealog description - see client_settings.js.dist.
# SEALOG_LOGIN_SCREEN_TXT=

# Optional image file shown on login page, under SEALOG_LOGIN_SCREEN_TXT.
# Must end in .jpg/.jpeg/.png and live in ./src/assets/images. Default is
# disabled.
# SEALOG_LOGIN_IMAGE=

# Text shown on the main page above the cruise list.
# Default is "Welcome to Sealog".
# SEALOG_MAIN_SCREEN_HEADER=Welcome to Sealog

# Text shown on the main page below SEALOG_MAIN_SCREEN_HEADER and above the
# cruise list.
# Default is the standard Sealog description - see client_settings.js.dist.
# SEALOG_MAIN_SCREEN_TXT=

# Default vessel used when creating new cruises.
# Default is "R/V Discovery".
# SEALOG_DEFAULT_VESSEL=R/V Discovery

# Add cruise-level authentication.
# This needs to match the 'useAccessControl' setting on the sealog-server.
# Default is false.
# SEALOG_USE_ACCESS_CONTROL=false

# Remove ability to add new events. Set to true for read-only instances of
# Sealog. Default is false.
# SEALOG_DISABLE_EVENT_LOGGING=false

# Optional placeholder text displayed in the CruiseID textfield, e.g.
# OXR20210101. Default is disabled.
# SEALOG_CRUISE_ID_PLACEHOLDER=

# Optional regular expression (source only, no slashes/flags) used to
# verify a cruise ID. Non-compliant cruise IDs are still allowed but a
# warning message is shown. Default is disabled.
# i.e. ^OXR20[0-9]{2}[0-1][0-9][0-3][0-9]$
# SEALOG_CRUISE_ID_REGEX=

# Optional customization for cruise nomenclature, as a comma-separated
# "singular,plural" pair, lowercase (capitalized in the client as needed).
# Default is "cruise,cruises".
# SEALOG_CUSTOM_CRUISE_NAME=cruise,cruises

# Comma-separated list of auxdata datasources that should be interpreted as
# vessel position, in order of importance.
# Default is "vesselRealtimeNavData".
# SEALOG_POSITION_DATASOURCES=vesselRealtimeNavData

# Optional comma-separated list of auxdata datasources that should NOT be
# displayed in the event history, cruise replay or cruise map. Default
# is disabled (none excluded).
# SEALOG_EXCLUDE_AUX_DATA_SOURCES=

# Comma-separated list of auxdata datasources that should be interpreted as
# imagery and formatted as such in the event history, cruise replay and
# cruise gallery.
# Default is "eventFileAttachments,framegrabber".
# SEALOG_IMAGES_AUX_DATA_SOURCES=eventFileAttachments,framegrabber

# Optional comma-separated list defining how to order auxdata datasources
# in the event history and cruise replay.
# Default is "eventFileAttachments,vesselRealtimeNavData".
# SEALOG_AUX_DATA_SORT_ORDER=eventFileAttachments,vesselRealtimeNavData

# Optional comma-separated list defining how to order event template
# categories, e.g. science,problem. Default is disabled (no explicit
# ordering).
# SEALOG_CATEGORY_SORT_ORDER=

# Default button color (Bootstrap variant name) used for event templates
# that do not specify their own event_button_color.
# Default is "primary".
# SEALOG_DEFAULT_EVENT_TEMPLATE_BUTTON_COLOR=primary
